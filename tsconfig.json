{
  "compilerOptions": {
    "target": "ES6", // Biên dịch về ES6
    "module": "CommonJS", // Hỗ trợ module của Node.js
    "moduleResolution": "node", // Hỗ trợ import module từ node_modules
    "esModuleInterop": true, // Cho phép cú pháp import ... from ...
    "resolveJsonModule": true, // Cho phép import từ file JSON
    "strict": true, // Bật chế độ kiểm tra chặt chẽ
    "skipLibCheck": true // Bỏ qua kiểm tra type của node_modules
  }
}
